---
import "katex/dist/katex.min.css";
import "../styles/site.css";

const {
  title = "Kimi K3 from Scratch",
  description = "An independent Kimi K3 language-backbone implementation and pretraining engineering project.",
  current = "",
} = Astro.props;

// The overview and file-level Docs are deliberately deferred. Keep them out of the main navigation.
const links = [
  { href: "/architecture/", label: "Architecture", id: "architecture" },
  { href: "/training/", label: "Training", id: "training" },
  { href: "/results/", label: "Results", id: "results" },
  { href: "/docs/", label: "Docs", id: "docs" },
];
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://kimi-k3.adriaflores.com/").toString();
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <script is:inline>
      (() => {
        // Dark is the project default. A visitor may explicitly select light mode.
        let saved;
        try { saved = localStorage.getItem("kimi-k3-theme"); } catch (_) {}
        const theme = saved === "light" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#090b10" : "#fbfcff");
      })();
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Kimi K3 project home">
          <span class="brand-mark">K<span>3</span></span>
          <span class="brand-label">KIMI K3 <small>FROM SCRATCH</small></span>
        </a>
        <nav class="top-nav" aria-label="Main navigation">
          {links.map(link => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}
        </nav>
        <div class="header-actions">
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
            <span class="theme-icon" aria-hidden="true">☀</span><span class="theme-label">Light</span>
          </button>
          <a class="header-github" href="https://github.com/adriaflores/kimi-k3-from-scratch" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div class="footer-ident"><span class="footer-logo">K3</span><span>An independent research engineering project.<br />Not affiliated with the Kimi team.</span></div>
        <div class="footer-links"><a href="https://github.com/adriaflores/kimi-k3-from-scratch" target="_blank" rel="noopener noreferrer">Source ↗</a><a href="https://adriaflores.com" target="_blank" rel="noopener noreferrer">Adrià Flores ↗</a></div>
        <div class="footer-end">Architecture · Training · Results</div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        function update() {
          const dark = document.documentElement.dataset.theme !== "light";
          const icon = button.querySelector(".theme-icon");
          const label = button.querySelector(".theme-label");
          if (icon) icon.textContent = dark ? "☀" : "☾";
          if (label) label.textContent = dark ? "Light" : "Dark";
          button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          button.title = dark ? "Switch to light theme" : "Switch to dark theme";
        }
        button.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", next === "dark" ? "#090b10" : "#fbfcff");
          try { localStorage.setItem("kimi-k3-theme", next); } catch (_) {}
          update();
        });
        update();
      })();
    </script>
  </body>
</html>
