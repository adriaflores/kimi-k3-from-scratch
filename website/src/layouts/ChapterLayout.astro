---
import SiteLayout from "./SiteLayout.astro";
import { chapterHref, type ChapterCollection, type ChapterEntry } from "../lib/chapters";

interface Heading { depth: number; slug: string; text: string }
interface Props {
  section: ChapterCollection;
  entry: ChapterEntry;
  headings: Heading[];
  previous?: ChapterEntry;
  next?: ChapterEntry;
}

const { section, entry, headings, previous, next } = Astro.props;
const sectionLabel = section === "architecture" ? "Architecture" : "Training";
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const inDevelopment = import.meta.env.DEV && entry.data.status !== "published";
---
<SiteLayout current={section} title={`${entry.data.title} — Kimi K3 from Scratch`} description={entry.data.description}>
  <div class="chapter-shell">
    <nav aria-label="Breadcrumb" class="chapter-breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${section}/`}>{sectionLabel}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="chapter-header">
      <div class="chapter-eyebrow">{sectionLabel} / {String(entry.data.order).padStart(2, "0")}</div>
      <h1>{entry.data.title}</h1>
      <p class="chapter-lead">{entry.data.question}</p>
      <p class="chapter-summary">{entry.data.description}</p>
      {inDevelopment && <p class="chapter-draft" role="status">Editorial preview · {entry.data.status}. This chapter is not included in the production site.</p>}
    </header>
    <div class="chapter-reading-grid">
      {toc.length > 0 && <aside class="chapter-toc" aria-label="On this page">
        <div class="chapter-toc-label">ON THIS PAGE</div>
        <nav aria-label="Chapter sections">
          {toc.map((heading) => <a class:list={["chapter-toc-link", { "chapter-toc-subsection": heading.depth === 3 }]} href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </aside>}
      <article class="chapter-body doc-prose"><slot /></article>
    </div>
    <nav class="chapter-footer-nav" aria-label="Adjacent chapters">
      <div>{previous && <a href={chapterHref(section, previous.id)}><span>← Previous</span><strong>{previous.data.title}</strong></a>}</div>
      <div>{next && <a href={chapterHref(section, next.id)}><span>Next →</span><strong>{next.data.title}</strong></a>}</div>
    </nav>
  </div>
</SiteLayout>
