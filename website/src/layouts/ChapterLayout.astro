---
import SiteLayout from "./SiteLayout.astro";
import { chapterHref, type ChapterCollection, type ChapterEntry } from "../lib/chapters";

interface Heading { depth: number; slug: string; text: string }
interface Props {
  section: ChapterCollection;
  entry: ChapterEntry;
  headings: Heading[];
  previous?: ChapterEntry;
  next?: ChapterEntry;
}

const { section, entry, headings, previous, next } = Astro.props;
const sectionLabel = section === "architecture" ? "Architecture" : "Training";
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const inDevelopment = import.meta.env.DEV && entry.data.status !== "published";
---
<SiteLayout current={section} title={`${entry.data.title} — Kimi K3 from Scratch`} description={entry.data.description}>
  <div class="chapter-reading-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="chapter-reading-progress-fill"></span>
  </div>
  <div class="chapter-shell">
    <nav aria-label="Breadcrumb" class="chapter-breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${section}/`}>{sectionLabel}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="chapter-header" id="chapter-start">
      <div class="chapter-eyebrow">{sectionLabel} / {String(entry.data.order).padStart(2, "0")}</div>
      <h1>{entry.data.title}</h1>
      <p class="chapter-lead">{entry.data.question}</p>
      <p class="chapter-summary">{entry.data.description}</p>
      {inDevelopment && <p class="chapter-draft" role="status">Editorial preview · {entry.data.status}. This chapter is not included in the production site.</p>}
    </header>
    <div class="chapter-reading-grid">
      {toc.length > 0 && <aside class="chapter-toc" aria-label="On this page">
        <div class="chapter-toc-label">IN THIS CHAPTER</div>
        <nav aria-label="Chapter sections">
          {toc.map((heading) => <a class:list={["chapter-toc-link", { "chapter-toc-subsection": heading.depth === 3 }]} href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
        <a class="chapter-toc-start" href="#chapter-start">↑ Back to beginning</a>
      </aside>}
      <article class="chapter-body doc-prose" aria-label={`${entry.data.title} chapter`}><slot /></article>
    </div>
    <nav class="chapter-footer-nav" aria-label="Adjacent chapters">
      <div>{previous && <a href={chapterHref(section, previous.id)}><span>← Previous</span><strong>{previous.data.title}</strong></a>}</div>
      <div>{next && <a href={chapterHref(section, next.id)}><span>Next →</span><strong>{next.data.title}</strong></a>}</div>
    </nav>
  </div>
  <script>
    // Navigation stays functional without JavaScript. This only marks the
    // currently read section for readers using the optional side index.
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".chapter-toc-link")];
    const sections = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    if (links.length && "IntersectionObserver" in window) {
      const setCurrent = (target: Element) => {
        for (const [index, link] of links.entries()) {
          if (sections[index] === target) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      };
      setCurrent(sections[0]!);
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target);
      }, { rootMargin: "-12% 0px -72% 0px", threshold: 0 });
      for (const section of sections) if (section) observer.observe(section);
    }
    // A subtle progress indicator, scoped to chapters and to the article itself.
    // At 100%, the reader has reached the end of the prose, not merely the footer.
    const progress = document.querySelector<HTMLElement>(".chapter-reading-progress");
    const progressFill = progress?.querySelector<HTMLElement>(".chapter-reading-progress-fill");
    const article = document.querySelector<HTMLElement>(".chapter-body");
    if (progress && progressFill && article) {
      let requested = false;
      const updateProgress = () => {
        requested = false;
        const rect = article.getBoundingClientRect();
        const readingLine = Math.min(window.innerHeight * 0.45, 320);
        const finishLine = Math.max(readingLine + 1, window.innerHeight - 60);
        const readingDistance = Math.max(1, rect.height + readingLine - finishLine);
        const fraction = Math.max(0, Math.min(1, (readingLine - rect.top) / readingDistance));
        progressFill.style.transform = `scaleX(${fraction})`;
        progress.setAttribute("aria-valuenow", String(Math.round(fraction * 100)));
      };
      const queueProgress = () => {
        if (requested) return;
        requested = true;
        requestAnimationFrame(updateProgress);
      };
      window.addEventListener("scroll", queueProgress, { passive: true });
      window.addEventListener("resize", queueProgress);
      updateProgress();
    }
  </script>
</SiteLayout>
