---
import SiteLayout from "../layouts/SiteLayout.astro";
import { chapterHref, getVisibleChapters } from "../lib/chapters";
const chapters = await getVisibleChapters("training");
---
<SiteLayout current="training" title="Training — Kimi K3 from Scratch" description="The engineering and experimentation journey from training-loop implementation to full pretraining.">
  <section class="page-intro"><div class="page-kicker">02 / THE PROCESS</div><h1>Building the <em>training system.</em></h1><p>Pretraining was not one script and one launch. It required engineering decisions, controlled experiments, and operational gates. This section explains the reasoning behind that sequence.</p></section>
  {chapters.length > 0 && <nav class="chapter-index training-index" aria-label="Training chapters">
    {chapters.map((chapter) => <a href={chapterHref("training", chapter.id)}><span>{String(chapter.data.order).padStart(2, "0")}</span> {chapter.data.title} <span>↗</span></a>)}
  </nav>}
  {chapters.length > 0 ? <div class="training-phases">
    {chapters.map((chapter) => <section class="training-phase">
      <div class="phase-number">{String(chapter.data.order).padStart(2, "0")}<span class="phase-stem" aria-hidden="true"></span></div>
      <div class="phase-copy"><div class="chapter-eyebrow">{chapter.data.title}</div><h2><a class="chapter-title-link" href={chapterHref("training", chapter.id)}>{chapter.data.question}</a></h2><p>{chapter.data.description}</p><div class="phase-artifacts">{import.meta.env.DEV && chapter.data.status !== "published" ? `EDITORIAL ${chapter.data.status.toUpperCase()} · ` : ""}<a class="chapter-source" href={chapterHref("training", chapter.id)}>Read chapter →</a></div></div>
    </section>)}
  </div> : <p class="empty-chapters">Training chapters are being prepared and reviewed. Only evidence-reviewed chapters will appear in the published index.</p>}
  <div class="page-endnote">Individual phases will connect decisions to actual code, methodology and measurements. Aggregate evidence belongs in <a href="/results/">Results ↗</a>.</div>
</SiteLayout>
