---
import SiteLayout from "../layouts/SiteLayout.astro";
const sections = [
  { index: "01", title: "Architecture", href: "/architecture/", kicker: "THE MODEL", description: "From the mechanisms described in the paper to a working language backbone: hybrid attention, attention residuals, MoE, and model assembly." },
  { index: "02", title: "Training", href: "/training/", kicker: "THE PROCESS", description: "From a first working training loop to instrumented experiments, scaling studies, GPU qualification, and full pretraining." },
  { index: "03", title: "Results", href: "/results/", kicker: "THE EVIDENCE", description: "Implementation checks and experimental results throughout the development, with carefully distinguished final-model evaluation." },
];
---
<SiteLayout title="Kimi K3 from Scratch — Project Index" description="A research engineering project index: architecture, training journey and experimental results.">
  <section class="gateway-hero">
    <div class="gateway-label"><span class="tiny-diamond"></span> INDEPENDENT RESEARCH ENGINEERING <span class="gateway-year">/ 2026</span></div>
    <div class="gateway-grid">
      <div>
        <h1>Kimi K3<br /><em>from scratch.</em></h1>
        <p>A scaled language backbone built in PyTorch, then brought through the engineering work required for pretraining. Explore the model, the process, and the evidence.</p>
        <div class="gateway-links"><a href="https://github.com/adriaflores/kimi-k3-from-scratch" target="_blank" rel="noopener noreferrer">Explore source ↗</a><a href="https://adriaflores.com" target="_blank" rel="noopener noreferrer">About the author ↗</a></div>
      </div>
      <div class="gateway-diagram" aria-label="From paper to the model, training system and results">
        <span class="visual-eyebrow">THE RESEARCH ENGINEERING PATH</span>
        <div class="gateway-node">Paper & research mechanisms <span>01</span></div>
        <div class="gateway-flow">↓</div>
        <div class="gateway-node accent-node">Model implementation <span>02</span></div>
        <div class="gateway-flow">↓</div>
        <div class="gateway-node">Training system & experiments <span>03</span></div>
        <div class="gateway-flow">↓</div>
        <div class="gateway-node">Measured evidence <span>04</span></div>
      </div>
    </div>
  </section>
  <section class="gateway-sections" aria-label="Explore the project">
    <div class="gateway-head"><span class="visual-eyebrow">EXPLORE THE PROJECT</span><span>Three routes into the work</span></div>
    <div class="gateway-card-grid">
      {sections.map(section => <a class="gateway-card" href={section.href}>
        <div class="gateway-card-top"><span>{section.index} / {section.kicker}</span><span>↗</span></div>
        <h2>{section.title}</h2><p>{section.description}</p><span class="gateway-card-bottom">Explore {section.title} →</span>
      </a>)}
    </div>
    <p class="gateway-note">This page is an index, not the final project overview. The overview and file-by-file reference documentation will be developed after the core sections stabilize.</p>
  </section>
</SiteLayout>
