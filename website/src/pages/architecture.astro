---
import SiteLayout from "../layouts/SiteLayout.astro";
import { chapterHref, getVisibleChapters } from "../lib/chapters";
const chapters = await getVisibleChapters("architecture");
---
<SiteLayout current="architecture" title="Architecture — Kimi K3 from Scratch" description="The implementation of the Kimi K3 language backbone, component by component, grounded in the architecture paper.">
  <section class="page-intro"><div class="page-kicker">01 / THE MODEL</div><h1>The <em>architecture.</em></h1><p>From the language-backbone mechanisms in the Kimi K3 paper to the complete PyTorch model. Each chapter connects an idea to its mathematics, implementation, and validation.</p><div class="journey"><span>Paper §2</span><span>→</span><span>Mechanisms</span><span>→</span><span>Modules</span><span>→</span><span>model.py</span></div></section>
  {chapters.length > 0 && <nav class="chapter-index" aria-label="Architecture chapters">
    {chapters.map((chapter) => <a href={chapterHref("architecture", chapter.id)}><span>{String(chapter.data.order).padStart(2, "0")}</span> {chapter.data.title} <span>↗</span></a>)}
  </nav>}
  <section class="arch-schematic" aria-label="Simplified backbone structure">
    <div class="schematic-head"><span class="visual-eyebrow">BACKBONE / ASSEMBLY</span><a href="https://github.com/adriaflores/kimi-k3-from-scratch/blob/main/src/kimi_k3/model.py" target="_blank" rel="noopener noreferrer">model.py ↗</a></div>
    <div class="schematic-flow"><div class="schematic-node">Token embeddings</div><span>→</span><div class="schematic-node schematic-primary">Hybrid Attention<br /><small>KDA / MLA</small></div><span>→</span><div class="schematic-node">AttnRes + FFN<br /><small>Dense / MoE</small></div><span>→</span><div class="schematic-node">Norm + LM head</div></div>
    <p>Conceptual assembly, not a literal operation-by-operation graph. Detailed explanations, equations and evidence belong in individual chapters.</p>
  </section>
  {chapters.length > 0 ? <div class="chapter-list">
    {chapters.map((chapter) => <section class="chapter-row">
      <div class="chapter-rail"><span>{String(chapter.data.order).padStart(2, "0")} / ARCHITECTURE</span><span class="chapter-paper">{import.meta.env.DEV && chapter.data.status !== "published" ? `Editorial ${chapter.data.status}` : "CHAPTER"}</span></div>
      <div class="chapter-main"><div class="chapter-eyebrow">{chapter.data.title}</div><h2><a class="chapter-title-link" href={chapterHref("architecture", chapter.id)}>{chapter.data.question}</a></h2><p>{chapter.data.description}</p><a class="chapter-source" href={chapterHref("architecture", chapter.id)}>Read chapter →</a></div>
    </section>)}
  </div> : <p class="empty-chapters">Architecture chapters are being prepared and reviewed. The index will grow as verified chapters are published.</p>}
  <div class="page-endnote">The paper's architecture, this reduced-scale implementation, and the validation evidence are distinct sources of claims. Each published chapter will identify them explicitly.</div>
</SiteLayout>
