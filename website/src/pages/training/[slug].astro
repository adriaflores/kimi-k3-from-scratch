---
import { render } from "astro:content";
import ChapterLayout from "../../layouts/ChapterLayout.astro";
import { getVisibleChapters } from "../../lib/chapters";

export async function getStaticPaths() {
  const chapters = await getVisibleChapters("training");
  return chapters.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: chapters[index - 1], next: chapters[index + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<ChapterLayout section="training" entry={entry} previous={previous} next={next} headings={headings}>
  <Content />
</ChapterLayout>
